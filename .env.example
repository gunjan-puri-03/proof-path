# YottaFlex KYC - Environment Configuration Example
# Copy this file to .env and fill in your values

# PostgreSQL Database Connection
DATABASE_URL=postgresql://kyc_user:kyc_password@localhost:5432/yottaflex_kyc

# PostgreSQL individual settings (alternative to DATABASE_URL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yottaflex_kyc
POSTGRES_USER=kyc_user
POSTGRES_PASSWORD=kyc_password

# Application settings
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-secure-random-string

# Data generator seed (fixed for reproducibility)
GENERATOR_SEED=20261022

# Data generator mode: starter | full
GENERATOR_MODE=full
